# Copy this file to `.env` and fill in your key.
#
# Needed only for AI-assisted syllabus extraction (POST /syllabus/extract).
# Everything else — manual topic entry, auditing, saved modules — works without it.
#
# Get a key: console.anthropic.com -> Settings -> API Keys -> Create Key
# (the API is prepaid and billed separately from a Claude.ai subscription)
ANTHROPIC_API_KEY=sk-ant-...
