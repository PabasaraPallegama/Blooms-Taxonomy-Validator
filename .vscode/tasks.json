{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: dev server",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: backend + frontend",
      "dependsOn": ["backend: dev server", "frontend: dev server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "train Bloom classifier",
      "type": "shell",
      "command": "python app/model/train.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
